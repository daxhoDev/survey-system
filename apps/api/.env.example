# Copy to .env and adjust. Documented in docs/sdd/05-configuration.md.

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/survey_system

# HTTP port (optional, default 3000)
PORT=3000

# development | production (required)
NODE_ENV=development

# HMAC secret for access JWTs, at least 32 characters (required)
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more

# Access JWT and `jwt` cookie lifetime, in minutes (required)
ACCESS_TOKEN_TTL_MINUTES=15

# Refresh token and `refresh` cookie lifetime, in days (required)
REFRESH_TOKEN_TTL_DAYS=7

# Allowed CORS origin, a single URL (required in production;
# defaults to http://localhost:5173 in development)
CORS_ORIGIN=http://localhost:5173

# pino level: fatal | error | warn | info | debug | trace | silent (optional, default info)
LOG_LEVEL=info
